    {
      "type": "stat",
      "title": "Valid joins succeeding",
      "description": "Joins that were not the player's or host's mistake and succeeded. Objective: 99.9 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kritzel_join_attempts_total{service_name=~\"$service\", deployment_environment_name=~\"$env\", kritzel_validity=\"valid\", kritzel_outcome!=\"rejected\"}[$__range])) / sum(increase(kritzel_join_attempts_total{service_name=~\"$service\", deployment_environment_name=~\"$env\", kritzel_validity=\"valid\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "no joins",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.99,
                "color": "yellow"
              },
              {
                "value": 0.999,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
