    {
      "type": "timeseries",
      "title": "Rejected messages by reason",
      "description": "bad_request and invalid_op point at broken or hostile clients; not_allowed is usually a late click.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (kritzel_reason) (rate(kritzel_messages_rejected_total{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "{{kritzel_reason}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "no data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
