            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum (increase(kritzel_games_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__range]))) or vector(0)) / (sum(increase(kritzel_games_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__range])) + ((sum (increase(kritzel_games_aborted_total{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__range]))) or vector(0)))",
          "legendFormat": "__auto",
          "range": false,
          "editorMode": "code",
          "instant": true
