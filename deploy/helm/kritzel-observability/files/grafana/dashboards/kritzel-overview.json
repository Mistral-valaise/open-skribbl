{
  "uid": "kritzel-overview",
  "title": "Kritzel / Global Overview",
  "description": "Is the instance healthy? Rate, errors and duration of requests, rooms, players and game activity.",
  "tags": [
    "kritzel"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Kritzel dashboards",
      "tags": [
        "kritzel"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "dashboards",
      "title": "Service level objectives",
      "tags": [
        "slo"
      ],
      "asDropdown": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kritzel_rooms_active, deployment_environment_name)",
          "refId": "A"
        },
        "definition": "label_values(kritzel_rooms_active, deployment_environment_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kritzel_rooms_active, service_name)",
          "refId": "A"
        },
        "definition": "label_values(kritzel_rooms_active, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Rooms",
      "description": "Live rooms in this instance.",
