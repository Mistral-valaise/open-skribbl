    {
      "type": "stat",
      "title": "Processed within 100 ms",
      "description": "Objective: 99 %. Server-side processing only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kritzel_ws_message_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$env\", le=\"0.1\"}[$__range])) / sum(increase(kritzel_ws_message_duration_seconds_count{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "no messages",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.95,
                "color": "yellow"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
