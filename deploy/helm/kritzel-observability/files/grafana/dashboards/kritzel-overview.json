    {
      "type": "timeseries",
      "title": "Games per minute",
      "description": "Counted once per game, when the room state changes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum (rate(kritzel_games_started_total{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "started",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(60 * sum (rate(kritzel_games_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$env\"}[$__rate_interval]))) or vector(0)",
